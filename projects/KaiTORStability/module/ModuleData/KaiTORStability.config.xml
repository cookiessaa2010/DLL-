<?xml version="1.0" encoding="utf-8"?>
<KaiTORStability>
  <!-- Battle optimization.
       When the TOR AddEffect activation hook is available, newly activated components are queued immediately
       and this slower safety rescan is only a fallback. If the hook cannot be installed, the conservative
       fullRescanIntervalMs path remains active automatically. -->
  <BattleStatusOptimization enabled="true" fullRescanIntervalMs="100" hookedSafetyRescanIntervalMs="1500" />

  <!-- Lightweight engine telemetry used by KaiTOR Load Monitor for real shader progress/ETA. -->
  <ShaderTelemetry enabled="true" sampleIntervalMs="500" />

  <!-- TOR Build Shader Cache optimization.
       Normal mode keeps enough duplicate soldiers to cover 2-3 equipment variants and preserves 4+ variants.
       On PCs at/below the configured physical-RAM threshold, lowMemorySafeMode collapses soldiers to one copy.
       This intentionally favors completing the prewarm without exhausting memory; missing equipment variants
       can still compile later during ordinary gameplay. -->
  <ShaderCacheAcceleration enabled="true"
                           singleLoadoutCopies="1"
                           lowMemorySafeMode="true"
                           lowMemoryPhysicalRamThresholdGb="24" />

  <!-- Safe default for KaiTOR Online / Bannerlord Coop. Loading/shader features stay active,
       but gameplay-affecting mission replacements are disabled while Coop is active. -->
  <CoopCompatibility disableGameplayPatches="true" />
</KaiTORStability>
