<?xml version="1.0" encoding="utf-8"?>
<KaiTORStability>
  <!-- Experimental battle optimization. Set enabled="false" for instant rollback without uninstalling the module. -->
  <BattleStatusOptimization enabled="true" fullRescanIntervalMs="100" />

  <!-- Lightweight engine telemetry used by KaiTOR Load Monitor for real shader progress/ETA. -->
  <ShaderTelemetry enabled="true" sampleIntervalMs="500" />

  <!-- Conservative TOR Build Shader Cache optimization.
       Soldiers with only one battle-equipment variant do not need TOR's four duplicate roster entries.
       Multi-loadout troops keep TOR's original multiplicity. -->
  <ShaderCacheAcceleration enabled="true" singleLoadoutCopies="1" />

  <!-- Safe default for KaiTOR Online / Bannerlord Coop. Loading/shader features stay active,
       but gameplay-affecting mission replacements are disabled while Coop is active. -->
  <CoopCompatibility disableGameplayPatches="true" />
</KaiTORStability>
