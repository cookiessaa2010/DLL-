<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Standard.Background/>

        <Standard.TopPanel Parameter.Title="@TitleText"/>

        <!--
          KaiTOR Diplomacy owns this movie exclusively.
          Network/co-op UI identifiers and resources must never be reused here.
          Native Bannerlord brushes are used until the dedicated diplomacy sprite atlas
          passes live UI validation.
        -->
        <Widget Id="KaiTORDiplomacyRoot"
                WidthSizePolicy="Fixed" SuggestedWidth="1460"
                HeightSizePolicy="Fixed" SuggestedHeight="860"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MarginTop="35">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9" Color="#6A1C12FF" AlphaFactor="0.46"
                    DoNotAcceptEvents="true"/>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginLeft="6" MarginRight="6" MarginTop="6" MarginBottom="6"
                    Sprite="BlankWhiteSquare_9" Color="#0D0908FF" AlphaFactor="0.95"
                    DoNotAcceptEvents="true"/>

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                       MarginLeft="26" MarginRight="26" MarginTop="26" MarginBottom="26"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44"
                            Brush="Clan.TabControl.Text" Brush.FontSize="22"
                            Brush.FontColor="#C9A66BFF"
                            Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center"
                            Text="@SubtitleText" DoNotAcceptEvents="true"/>

                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64"
                           MarginTop="8" MarginBottom="18"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <Standard.Button WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     MarginRight="8" Command.Click="ActionSelectOverview"
                                     Parameter.Text="@OverviewTabText"/>
                    <Standard.Button WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     MarginRight="8" Command.Click="ActionSelectDiplomacy"
                                     Parameter.Text="@DiplomacyTabText"/>
                    <Standard.Button WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     MarginRight="8" Command.Click="ActionSelectFamily"
                                     Parameter.Text="@FamilyTabText"/>
                    <Standard.Button WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     Command.Click="ActionSelectPopulation"
                                     Parameter.Text="@PopulationTabText"/>
                  </Children>
                </ListPanel>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="635">
                  <Children>
                    <!-- Overview -->
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                               IsVisible="@IsOverviewVisible"
                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="820" HeightSizePolicy="StretchToParent"
                                MarginRight="18">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#15100EFF" AlphaFactor="0.94"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="28" MarginRight="28" MarginTop="24" MarginBottom="24"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="31"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@TitleText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="360"
                                            MarginTop="20"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="27"
                                            Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top"
                                            Text="@OverviewText"/>
                                <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="250"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="58"
                                                 HorizontalAlignment="Left" MarginTop="20"
                                                 Command.Click="ActionRefresh"
                                                 Parameter.Text="@RefreshText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#100C0BFF" AlphaFactor="0.92"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="28" MarginRight="28" MarginTop="24" MarginBottom="24"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="29"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@ResultHeaderText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="260"
                                            MarginTop="14"
                                            IsVisible="@IsActionResultVisible"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="24"
                                            Brush.FontColor="#D9C3A2FF"
                                            Brush.TextVerticalAlignment="Top"
                                            Text="@ActionResultText"/>
                                <Standard.Button WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="58"
                                                 MarginTop="18"
                                                 Command.Click="ActionOpenFallbackHub"
                                                 Parameter.Text="@FallbackHubText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ListPanel>

                    <!-- Diplomacy -->
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                               IsVisible="@IsDiplomacyVisible"
                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="760" HeightSizePolicy="StretchToParent"
                                MarginRight="18">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#15100EFF" AlphaFactor="0.95"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="22" MarginRight="22" MarginTop="20" MarginBottom="20"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="29"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@SelectKingdomHeaderText"/>

                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="485"
                                        MarginTop="12">
                                  <Children>
                                    <ScrollablePanel Id="KaiTORDiplomacyRealmScroll"
                                                     WidthSizePolicy="StretchToParent"
                                                     HeightSizePolicy="StretchToParent"
                                                     MarginRight="20"
                                                     AutoHideScrollBars="true"
                                                     ClipRect="KaiTORDiplomacyRealmClip"
                                                     InnerPanel="KaiTORDiplomacyRealmClip\KaiTORDiplomacyRealmList"
                                                     VerticalScrollbar="..\KaiTORDiplomacyRealmScrollbar">
                                      <Children>
                                        <Widget Id="KaiTORDiplomacyRealmClip"
                                                WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="StretchToParent"
                                                ClipContents="true">
                                          <Children>
                                            <NavigatableListPanel Id="KaiTORDiplomacyRealmList"
                                                                  DataSource="{Kingdoms}"
                                                                  WidthSizePolicy="StretchToParent"
                                                                  HeightSizePolicy="CoverChildren"
                                                                  StackLayout.LayoutMethod="VerticalTopToBottom">
                                              <ItemTemplate>
                                                <ButtonWidget WidthSizePolicy="StretchToParent"
                                                              HeightSizePolicy="Fixed" SuggestedHeight="82"
                                                              MarginBottom="8"
                                                              Brush="Header.Tab.Center"
                                                              Command.Click="ExecuteSelect"
                                                              IsSelected="@IsSelected"
                                                              DoNotPassEventsToChildren="true"
                                                              UpdateChildrenStates="true">
                                                  <Children>
                                                    <ListPanel WidthSizePolicy="StretchToParent"
                                                               HeightSizePolicy="StretchToParent"
                                                               MarginLeft="14" MarginRight="14"
                                                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                                                      <Children>
                                                        <TextWidget WidthSizePolicy="StretchToParent"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="Clan.TabControl.Text"
                                                                    Brush.FontSize="25"
                                                                    Brush.TextVerticalAlignment="Center"
                                                                    Text="@NameText"/>
                                                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="190"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="Clan.TabControl.Text"
                                                                    Brush.FontSize="22"
                                                                    Brush.TextHorizontalAlignment="Center"
                                                                    Brush.TextVerticalAlignment="Center"
                                                                    Text="@StatusText"/>
                                                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="160"
                                                                    HeightSizePolicy="StretchToParent"
                                                                    Brush="Clan.TabControl.Text"
                                                                    Brush.FontSize="22"
                                                                    Brush.TextHorizontalAlignment="Right"
                                                                    Brush.TextVerticalAlignment="Center"
                                                                    Text="@TrustText"/>
                                                      </Children>
                                                    </ListPanel>
                                                  </Children>
                                                </ButtonWidget>
                                              </ItemTemplate>
                                            </NavigatableListPanel>
                                          </Children>
                                        </Widget>
                                        <ScrollbarWidget Id="KaiTORDiplomacyRealmScrollbar"
                                                         WidthSizePolicy="Fixed" SuggestedWidth="15"
                                                         HeightSizePolicy="StretchToParent"
                                                         HorizontalAlignment="Right"
                                                         AlignmentAxis="Vertical"
                                                         Handle="KaiTORDiplomacyRealmScrollbar\Handle">
                                          <Children>
                                            <Widget Id="Handle"
                                                    WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="Fixed" SuggestedHeight="60"
                                                    Sprite="BlankWhiteSquare_9"
                                                    Color="#8F6B3EFF"/>
                                          </Children>
                                        </ScrollbarWidget>
                                      </Children>
                                    </ScrollablePanel>
                                  </Children>
                                </Widget>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#100C0BFF" AlphaFactor="0.94"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="28" MarginRight="28" MarginTop="22" MarginBottom="22"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="29"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@SelectedRealmHeaderText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="250"
                                            MarginTop="12"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="24"
                                            Brush.TextVerticalAlignment="Top"
                                            Text="@SelectedKingdomText"/>

                                <Standard.Button WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="58"
                                                 MarginTop="12"
                                                 Command.Click="ActionCycleDuration"
                                                 Parameter.Text="@DurationButtonText"/>
                                <Standard.Button WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="58"
                                                 MarginTop="12"
                                                 IsDisabled="@IsProposeDisabled"
                                                 Command.Click="ActionProposeNap"
                                                 Parameter.Text="@ProposeNapText"/>
                                <Standard.Button WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="58"
                                                 MarginTop="12"
                                                 IsDisabled="@IsBreakDisabled"
                                                 Command.Click="ActionBreakNap"
                                                 Parameter.Text="@BreakNapText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ListPanel>

                    <!-- Family -->
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                               IsVisible="@IsFamilyVisible"
                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                MarginRight="18">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#15100EFF" AlphaFactor="0.95"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="32" MarginRight="32" MarginTop="28" MarginBottom="28"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="31"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@FamilyHeaderText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="330"
                                            MarginTop="18"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="27"
                                            Brush.TextVerticalAlignment="Top"
                                            Text="@FamilySummaryText"/>
                                <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="410"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="62"
                                                 HorizontalAlignment="Left"
                                                 Command.Click="ActionOpenFamily"
                                                 Parameter.Text="@OpenFamilyText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="520" HeightSizePolicy="StretchToParent">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#100C0BFF" AlphaFactor="0.94"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="28" MarginRight="28" MarginTop="28" MarginBottom="28"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="29"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@ResultHeaderText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="280"
                                            MarginTop="16"
                                            IsVisible="@IsActionResultVisible"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="24"
                                            Brush.TextVerticalAlignment="Top"
                                            Text="@ActionResultText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ListPanel>

                    <!-- Population and culture -->
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                               IsVisible="@IsPopulationVisible"
                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                MarginRight="18">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#15100EFF" AlphaFactor="0.95"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="30" MarginRight="30" MarginTop="24" MarginBottom="24"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="30"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@PopulationHeaderText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="300"
                                            MarginTop="14"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="25"
                                            Brush.TextVerticalAlignment="Top"
                                            Text="@PopulationSummaryText"/>
                                <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="440"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="60"
                                                 HorizontalAlignment="Left" MarginTop="14"
                                                 Command.Click="ActionDawiTest"
                                                 Parameter.Text="@DawiTestText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>

                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="StretchToParent">
                          <Children>
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9" Color="#100C0BFF" AlphaFactor="0.94"/>
                            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                       MarginLeft="28" MarginRight="28" MarginTop="24" MarginBottom="24"
                                       StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="48"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="29"
                                            Brush.FontColor="#D5B275FF"
                                            Text="@CultureHeaderText"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="230"
                                            MarginTop="14"
                                            Brush="Clan.TabControl.Text" Brush.FontSize="24"
                                            Brush.TextVerticalAlignment="Top"
                                            Text="@CultureSummaryText"/>
                                <Standard.Button WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="60"
                                                 MarginTop="14"
                                                 Command.Click="ActionOpenCulture"
                                                 Parameter.Text="@OpenCultureText"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64"
                           MarginTop="18"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"/>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="230"
                                     HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     Command.Click="ActionClose"
                                     Parameter.Text="@CloseText"/>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
