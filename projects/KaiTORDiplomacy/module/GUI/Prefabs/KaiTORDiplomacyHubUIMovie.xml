<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Standard.Background/>
        <Standard.TopPanel Parameter.Title="@TitleText"/>

        <!-- DIAG-A: intentionally minimal.
             No ScrollablePanel, no NavigatableListPanel, no ItemTemplate,
             no custom ScrollbarWidget. -->
        <Widget Id="KaiTORDiplomacyRoot"
                WidthSizePolicy="Fixed" SuggestedWidth="980"
                HeightSizePolicy="Fixed" SuggestedHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <Widget WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9"
                    Color="#0D0908FF"
                    AlphaFactor="0.96"
                    DoNotAcceptEvents="true"/>

            <ListPanel WidthSizePolicy="StretchToParent"
                       HeightSizePolicy="StretchToParent"
                       MarginLeft="40" MarginRight="40"
                       MarginTop="40" MarginBottom="40"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed" SuggestedHeight="54"
                            Brush="Clan.TabControl.Text"
                            Brush.FontSize="32"
                            Brush.FontColor="#D5B275FF"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.TextVerticalAlignment="Center"
                            Text="@TitleText"/>

                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed" SuggestedHeight="44"
                            MarginTop="10"
                            Brush="Clan.TabControl.Text"
                            Brush.FontSize="22"
                            Brush.FontColor="#C9A66BFF"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.TextVerticalAlignment="Center"
                            Text="@SubtitleText"/>

                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed" SuggestedHeight="260"
                            MarginTop="30"
                            Brush="Clan.TabControl.Text"
                            Brush.FontSize="25"
                            Brush.TextHorizontalAlignment="Left"
                            Brush.TextVerticalAlignment="Top"
                            Text="@OverviewText"/>

                <ListPanel WidthSizePolicy="StretchToParent"
                           HeightSizePolicy="Fixed" SuggestedHeight="64"
                           MarginTop="24"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="260"
                                     HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     Command.Click="ActionRefresh"
                                     Parameter.Text="@RefreshText"/>
                    <Widget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"/>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="220"
                                     HeightSizePolicy="Fixed" SuggestedHeight="58"
                                     Command.Click="ActionClose"
                                     Parameter.Text="@CloseText"/>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
