<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Standard.Background/>
        <Standard.TopPanel Parameter.Title="@TitleText"/>

        <!-- DiplomacyFinish safe functional static dashboard. -->
        <Widget Id="KaiTORDiplomacyRoot"
                WidthSizePolicy="Fixed" SuggestedWidth="1220"
                HeightSizePolicy="Fixed" SuggestedHeight="790"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MarginTop="24">
          <Children>
            <Widget WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="StretchToParent"
                    Sprite="BlankWhiteSquare_9"
                    Color="#0D0908FF"
                    AlphaFactor="0.96"
                    DoNotAcceptEvents="true"/>

            <ListPanel WidthSizePolicy="StretchToParent"
                       HeightSizePolicy="StretchToParent"
                       MarginLeft="34" MarginRight="34"
                       MarginTop="28" MarginBottom="24"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed" SuggestedHeight="42"
                            Brush="Clan.TabControl.Text"
                            Brush.FontSize="24"
                            Brush.FontColor="#C9A66BFF"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.TextVerticalAlignment="Center"
                            Text="@SubtitleText"/>

                <ListPanel WidthSizePolicy="StretchToParent"
                           HeightSizePolicy="Fixed" SuggestedHeight="530"
                           MarginTop="16"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent"
                               HeightSizePolicy="StretchToParent"
                               MarginRight="18"
                               StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="42"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="29"
                                    Brush.FontColor="#D5B275FF"
                                    Text="@TitleText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="150"
                                    MarginTop="10"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="23"
                                    Brush.TextVerticalAlignment="Top"
                                    Text="@OverviewText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="38"
                                    MarginTop="8"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="25"
                                    Brush.FontColor="#D5B275FF"
                                    Text="@FamilyHeaderText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="112"
                                    MarginTop="6"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="22"
                                    Brush.TextVerticalAlignment="Top"
                                    Text="@FamilySummaryText"/>

                        <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="330"
                                         HeightSizePolicy="Fixed" SuggestedHeight="54"
                                         MarginTop="8"
                                         Command.Click="ActionOpenFamily"
                                         Parameter.Text="@OpenFamilyText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="34"
                                    MarginTop="12"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="23"
                                    Brush.FontColor="#D5B275FF"
                                    Text="@PopulationHeaderText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="104"
                                    MarginTop="4"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="20"
                                    Brush.TextVerticalAlignment="Top"
                                    Text="@PopulationSummaryText"/>
                      </Children>
                    </ListPanel>

                    <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="555"
                               HeightSizePolicy="StretchToParent"
                               StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="42"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="29"
                                    Brush.FontColor="#D5B275FF"
                                    Text="@SelectedRealmHeaderText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="138"
                                    MarginTop="10"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="22"
                                    Brush.TextVerticalAlignment="Top"
                                    Text="@SelectedKingdomText"/>

                        <ListPanel WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="Fixed" SuggestedHeight="56"
                                   MarginTop="8"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <Standard.Button WidthSizePolicy="StretchToParent"
                                             HeightSizePolicy="Fixed" SuggestedHeight="52"
                                             MarginRight="8"
                                             Command.Click="ActionChooseRealm"
                                             Parameter.Text="@ChooseRealmText"/>
                            <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="235"
                                             HeightSizePolicy="Fixed" SuggestedHeight="52"
                                             Command.Click="ActionCycleDuration"
                                             Parameter.Text="@DurationButtonText"/>
                          </Children>
                        </ListPanel>

                        <ListPanel WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="Fixed" SuggestedHeight="58"
                                   MarginTop="8"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <Standard.Button WidthSizePolicy="StretchToParent"
                                             HeightSizePolicy="Fixed" SuggestedHeight="54"
                                             MarginRight="8"
                                             Command.Click="ActionProposeNap"
                                             Parameter.Text="@ProposeNapText"/>
                            <Standard.Button WidthSizePolicy="StretchToParent"
                                             HeightSizePolicy="Fixed" SuggestedHeight="54"
                                             Command.Click="ActionBreakNap"
                                             Parameter.Text="@BreakNapText"/>
                          </Children>
                        </ListPanel>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="34"
                                    MarginTop="12"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="23"
                                    Brush.FontColor="#D5B275FF"
                                    Text="@CultureHeaderText"/>

                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed" SuggestedHeight="92"
                                    MarginTop="4"
                                    Brush="Clan.TabControl.Text"
                                    Brush.FontSize="20"
                                    Brush.TextVerticalAlignment="Top"
                                    Text="@CultureSummaryText"/>

                        <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="360"
                                         HeightSizePolicy="Fixed" SuggestedHeight="52"
                                         MarginTop="6"
                                         Command.Click="ActionOpenCulture"
                                         Parameter.Text="@OpenCultureText"/>
                      </Children>
                    </ListPanel>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="Fixed" SuggestedHeight="72"
                            MarginTop="12"
                            Brush="Clan.TabControl.Text"
                            Brush.FontSize="20"
                            Brush.FontColor="#D9C3A2FF"
                            Brush.TextVerticalAlignment="Top"
                            Text="@ActionResultText"/>

                <ListPanel WidthSizePolicy="StretchToParent"
                           HeightSizePolicy="Fixed" SuggestedHeight="58"
                           MarginTop="8"
                           StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="230"
                                     HeightSizePolicy="Fixed" SuggestedHeight="54"
                                     Command.Click="ActionRefresh"
                                     Parameter.Text="@RefreshText"/>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="300"
                                     HeightSizePolicy="Fixed" SuggestedHeight="54"
                                     MarginLeft="10"
                                     Command.Click="ActionOpenFallbackHub"
                                     Parameter.Text="@FallbackHubText"/>
                    <Widget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"/>
                    <Standard.Button WidthSizePolicy="Fixed" SuggestedWidth="210"
                                     HeightSizePolicy="Fixed" SuggestedHeight="54"
                                     Command.Click="ActionClose"
                                     Parameter.Text="@CloseText"/>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
