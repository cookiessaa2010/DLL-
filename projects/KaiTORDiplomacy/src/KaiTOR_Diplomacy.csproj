<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KaiTOR_Diplomacy</AssemblyName>
    <RootNamespace>KaiTOR.Diplomacy</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.6.5.10</Version>
    <AssemblyVersion>0.6.5.10</AssemblyVersion>
    <FileVersion>0.6.5.10</FileVersion>
    <InformationalVersion>0.6.5.10-DawiFemaleRender-TorActionDelegation</InformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\build\bin\Win64_Shipping_Client\</OutputPath>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <UseBannerlordReferenceAssemblies Condition="'$(UseBannerlordReferenceAssemblies)' == ''">false</UseBannerlordReferenceAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseBannerlordReferenceAssemblies)' != 'true'">
    <BannerlordRoot Condition="'$(BannerlordRoot)' == ''">$(BANNERLORD_ROOT)</BannerlordRoot>
    <BannerlordBin>$(BannerlordRoot)\bin\Win64_Shipping_Client</BannerlordBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBannerlordReferenceAssemblies)' == 'true'">
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.3.15.110062" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBannerlordReferenceAssemblies)' != 'true'">
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(BannerlordBin)\TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection"><HintPath>$(BannerlordBin)\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(BannerlordBin)\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(BannerlordBin)\TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI"><HintPath>$(BannerlordBin)\TaleWorlds.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(BannerlordBin)\TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(BannerlordBin)\TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ModuleManager"><HintPath>$(BannerlordBin)\TaleWorlds.ModuleManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(BannerlordBin)\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(BannerlordBin)\TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ScreenSystem"><HintPath>$(BannerlordBin)\TaleWorlds.ScreenSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
